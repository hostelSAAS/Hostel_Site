VITE_API_URL=http://localhost:5000/api
# Optional: defaults to the API origin. Override only if sockets use another origin.
VITE_SOCKET_URL=
# Used by the student portal's owner link during local development.
VITE_OWNER_PORTAL_URL=http://localhost:5174
# Production: set VITE_API_URL=https://<public-api-host>/api in the hosting dashboard.
# HTTPS is required for production builds; localhost and missing API URLs are rejected.
# Set VITE_OWNER_PORTAL_URL to the production owner portal on the student deployment.
